<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benches Database</title>
    <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header>
        <nav class="nav-links">
            <img src="https://pittsburghparks.org/wp-content/uploads/2020/09/PPC-Logo_Horizontal_Green_RGB.png" class="logo">
            <div style="display: flex; gap: 0rem;">
            <a href="/">Home</a>
            <a class="current" href="/entry">Add Bench</a>
            <a href="/maps">View Maps</a>
            <a href="/addmap">Add Map</a>
            <a href="/userguide">User Guide</a>
            </div>
        </nav>
    </header>

    <main>
        <form href="/entry" method="POST" class="form">
        <% errors.forEach(error => { %>
            <p class="notice"><%= error %></p>
        <% })%>
            <fieldset>

                <label for="benchnum"><small>Bench Number</small></label>
                <input type="number" id="benchnum" name="benchnum" autocomplete="off">

                <label for="available"><small>Available?</small></label>
                <select id="available" name="available">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>

                <label for="park"><small>Park</small></label>
                <select id="park" name="park">
                    <option value="Frick">Frick</option>
                    <option value="Allegheny Commons">Allegheny Commons</option>
                    <option value="Schenley">Schenley</option>
                    <option value="Mellon">Mellon Park</option>
                    <option value="Cliffside">Cliffside</option>
                    <option value="Highland">Highland</option>
                    <option value="Riverview">Riverview</option>
                    <option value="FEC">FEC</option>
                    <option value="Flagstaff">Flagstaff</option>
                </select>

                <label for="imoiho"><small>IMO or IHO</small></label>
                <select id="imoiho" name="imoiho">
                    <option value="none">None</option>
                    <option value="imo">IMO</option>
                    <option value="iho">IHO</option>
                </select>

                <label for="honoree"><small>Honoree's Name</small></label>
                <input type="text" id="honoree" name="honoree" autocomplete="off">

                <label for="donor"><small>Donated By</small></label>
                <input type="text" id="donor" name="donor" autocomplete="off">

                <label for="constid"><small>Donor's Constituent ID</small></label>
                <input type="number" id="constid" name="constid" autocomplete="off">

                <label for="inscription"><small>Inscription</small></label>
                <input type="text" id="inscription" name="inscription" autocomplete="off">

                <label for="giftamt"><small>Gift Amount</small></label>
                <input type="number" id="giftamt" name="giftamt" min="0" max ="1000000000" step="0.01" autocomplete="off">

                <label for="giftdate"><small>Gift Date</small></label>
                <input type="date" id="giftdate" name="giftdate" autocomplete="off">

                <label for="infull"><small>Paid in full?</small></label>
                <select id="infull" name="infull">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>

                <label for="notes"><small>Notes</small></label>
                <textarea id="notes" name="notes"></textarea>

                <br />
                <button>Submit</button>
            </fieldset>
        </form>
    </main>

    <footer>
        <small>Pittsburgh Parks</small>
    </footer>
</body>
</html>