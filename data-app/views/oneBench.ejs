<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benches Database</title>
    <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <header>
        <nav class="one-bench">
        <a href="/" class="left">Home</a>
        <h2 class="center"><%= bench.park %> #<%= bench.benchnum %></h2>
        <a href="/maps" class="right">Maps</a>
        </nav>
    </header>
    <main>
            <article>
                <b>Availability:</b>
                <% if(bench.available === 1){ %>
                    Available
                    <br>
                    <br><b>Notes:</b><article>
                        <%= bench.notes %>
                    </article>
                <% }
                else { %>
                    Sold
                    <br>
                    <b>In 
                        <% if(bench.imoiho === 'iho') { %>
                            Honor Of:
                        <% } else { %>
                            Memory Of:
                        <% } %>
                    </b> <%= bench.honoree %>
                    <br> <b>Donated By:</b> <%= bench.donor %> [Constituent ID: <%= bench.constid %>]
                    <br><br><b>Inscription:</b><article>
                            <%= bench.inscription %>
                        </article>
                    <br><b>Notes:</b><article>
                            <%= bench.notes %>
                        </article>
                    <br> <small>Bought on <%= bench.giftdate %> for $<%= bench.giftamt %>. <% if(bench.infull === 1){ %>Paid in full.<%} else {%>Not paid in full.<%}%> </small>
                <% } %>
            </article>

            <form action="/bench/delete/<%= bench.id %>" method="POST" class="form" onsubmit="return confirm('Are you sure you want to delete this bench?');">
                <a href="/entry/edit-bench/<%= bench.id %>">Edit Bench</a>
                <button>Delete Bench</button>
            </form>
    </main>
</body>
</html>