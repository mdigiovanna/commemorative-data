<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benches Database</title>
    <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header>
        <nav class="nav-links">
            <img src="https://pittsburghparks.org/wp-content/uploads/2020/09/PPC-Logo_Horizontal_Green_RGB.png" class="logo">
            <div style="display: flex; gap: 0rem;">
            <a class="current" href="/">Home</a>
            <a href="/entry">Add Bench</a>
            <a href="/maps">View Maps</a>
            <a href="/addmap">Add Map</a>
            <a href="/userguide">User Guide</a>
            </div>
        </nav>
    </header>

<!--
    allParks array and byPark SQL command sent in from server.js;
    for each park in allParks, created an unordered list and use byPark.all 
    to get benches in that park -> for each park, loop through the benches 
    and provide each as a list element with a link to the bench's page 
-->

    <main>
        <% allParks.forEach(park => {%>
        <h3><%= park %></h3>
            <article class="homepage-section">      

                <ul class="homepage-list">
                    <% byPark.all(park).forEach (bench => {%>
                    <li><a href="/bench/<%= bench.id %>"><%= bench.park %> #<%= bench.benchnum %></a></li>
                    <%})%>
                </ul>
            
            </article>
        <%})%>
    </main>

    <footer>
        <small>Pittsburgh Parks</small>
    </footer>
</body>
</html>