<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benches Database</title>
    <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <header>
        <nav class="nav-links">
            <img src="https://pittsburghparks.org/wp-content/uploads/2020/09/PPC-Logo_Horizontal_Green_RGB.png" class="logo">
            <div style="display: flex; gap: 0rem;">
            <a href="/">Home</a>
            <a href="/entry">Add Bench</a>
            <a class="current" href="/maps">View Maps</a>
            <a href="/addmap">Add Map</a>
            <a href="/userguide">User Guide</a>
            </div>
        </nav>
    </header>

    <main>
        <% allMaps.all().forEach(map => {%>
        <h3><%= map.name %></h3>
        <section class="map-card">
                <div style="display: inline-block; position:relative; text-align:center;">
                    <img src='/maps/image/<%= map.id %>' alt="<%= map.name %> Map" class="map-image" id="mapImage-<%= map.id %>">
                    <% byMap.all(map.id).forEach (bench => {%>
                        <a href="/bench/<%= bench.id %>">
                            <div
                            style="width: 50px;
                            height: 50px;
                            background-color: white;
                            border-radius: 50%;
                            border: 3px solid black;
                            left: <%= bench.x -25%>px;
                            top: <%= bench.y -25%>px;
                            position: absolute;
                            display: flex;
                            align-items: center;
                            justify-content: center">
                            <p style="color:black; font-weight: 700;"> <%= bench.benchnum %> </p>
                            </div>

                        <% if (! bench.available) { %>
                            <div 
                            style="width:45;
                            height:8;
                            content:'';
                            background-color: red;
                            opacity: 60%;
                            transform: rotate(45deg);
                            left: <%= bench.x -23%>;
                            top: <%= bench.y -4%>;
                            position: absolute">
                            </div>
                            
                            <div 
                            style="width:45;
                            height:8;
                            content:'';
                            background-color: red;
                            opacity: 60%;
                            transform: rotate(-45deg);
                            left: <%= bench.x -23%>;
                            top: <%= bench.y -4%>;
                            position: absolute">
                            </div>
                        <% } %>
                        </a>
                        <div 
                            id="pinPreview-<%= map.id %>" 
                            style="width: 20px; height: 20px; background: red; border-radius: 50%;
                                position: absolute; transform: translate(-50%, -50%); display: none;">
                        </div>
                    <%})%>
                </div>
            <form action="/bench/edit" method="POST" class="form">
                <fieldset style="display:flex; justify-content: space-between;"">

                    <input type="hidden" name="mapid" value="<%= map.id %>">

                    <div style="display: flex; gap: 2rem;">
                    <div style="display: inline-block">
                        <label for="bench">Bench:</label>
                        <select id="bench" name="bench">
                        <% allBenches.all().forEach(bench => {%>
                            <option value="<%= bench.id %>"><%= bench.park %> #<%= bench.benchnum %></option>
                        <%})%>
                        </select>
                    </div>
                    
                    <div style="display: inline-block">
                        <label for="x-<%= map.id %>">X:</label>
                        <input type="number" id="x-<%= map.id %>" name="x" min="0" max="1000" step="1">
                    </div>

                    <div style="display: inline-block">
                        <label for="y-<%= map.id %>">Y:</label>
                        <input type="number" id="y-<%= map.id %>" name="y" min="0" max="1000" step="1">
                    </div>
                    </div>

                    <div>
                        <br>
                        <button type="submit">Add</button>
                    </div>
                    </fieldset>
                </form>
                <form action="/maps/delete/<%= map.id %>" method="POST" class="del-form" onsubmit="return confirm('Are you sure you want to delete this map?');">
                    <button>Delete <%= map.name %></button>
                </form>

            <script>
                (() => {
                  const img = document.getElementById("mapImage-<%= map.id %>");
                  const pin = document.getElementById("pinPreview-<%= map.id %>");
                  const xInput = document.getElementById("x-<%= map.id %>");
                  const yInput = document.getElementById("y-<%= map.id %>");
              
                  // Click to set coordinates
                  img.addEventListener("click", (e) => {
                    const rect = img.getBoundingClientRect();
                    const clickX = (e.clientX - rect.left);
                    const clickY = (e.clientY - rect.top);
                    xInput.value = Math.round(clickX);
                    yInput.value = Math.round(clickY);
                    updatePin();
                  });
              
                  // Update pin when inputs change
                  const updatePin = () => {
                    const x = parseInt(xInput.value);
                    const y = parseInt(yInput.value);
                    if (!isNaN(x) && !isNaN(y)) {
                      pin.style.left = `${x}px`;
                      pin.style.top = `${y}px`;
                      pin.style.display = "block";
                    } else {
                      pin.style.display = "none";
                    }
                  };
              
                  xInput.addEventListener("input", updatePin);
                  yInput.addEventListener("input", updatePin);
                })();
            </script>
        </section>
        <%})%>
    </main>

    <footer>
        <small>Pittsburgh Parks</small>
    </footer>
</body>
</html>