<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benches Database</title>
    <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header>
        <nav class="nav-links">
            <img src="https://pittsburghparks.org/wp-content/uploads/2020/09/PPC-Logo_Horizontal_Green_RGB.png" class="logo">
            <div style="display: flex; gap: 0rem;">
            <a href="/">Home</a>
            <a href="/entry">Add Bench</a>
            <a href="/maps">View Maps</a>
            <a class="current" href="/addmap">Add Map</a>
            <a href="/userguide">User Guide</a>
            </div>
        </nav>
    </header>

    <main>
        <form href="/addmap" method="POST" enctype="multipart/form-data" class="form">
            <fieldset>

                <label for="name"><small>Map Title</small></label>
                <input type="text" id="name" name="name" autocomplete="off">

                <label for="picture">Upload map image:</label>
                <input type="file" id="picture" name="picture">
                <br>

                <button>Submit</button>
            </fieldset>
        </form>
    </main>

    <footer>
        <small>Pittsburgh Parks</small>
    </footer>
</body>
</html>